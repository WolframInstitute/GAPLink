            {Cell["      ", "TableRowIcon"],
                Cell[BoxData["\"Version\""], "TableText"],
                Cell[BoxData["Automatic"], "TableText"],
                Cell["Compatible package version", "TableText"]}
        }]], "3ColumnTableMod"],
        Cell["The check does not load or install the package.", "Notes"]
