        ], "ExampleInitialization"]
    }, Open]],
    Cell[CellGroupData[{
        Cell["Basic Examples", "PrimaryExamplesSection"],
        Cell["Check a package included with GAP:", "ExampleText"],
        Cell[BoxData[
