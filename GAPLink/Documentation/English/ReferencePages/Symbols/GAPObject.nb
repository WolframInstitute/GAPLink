(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{
    Cell[CellGroupData[{
        Cell["GAPObject", "ObjectName"],
        Cell[TextData[{
            Cell["   ", "ModInfo"],
            Cell[BoxData[
                RowBox[{"GAPObject", "[", "...", "]"}]
            ], "InlineFormula"],
            " represents a value kept in GAP."
        }], "Usage"],
        Cell["GAPCall and GAPEvaluate return GAPObject when a result stays in GAP.", "Notes"],
        Cell["A GAPObject belongs to one GAPSession and can be used in later calls to that session.", "Notes"],
        Cell[TextData[{
            Cell[BoxData[
                RowBox[{"Normal", "[", "object", "]"}]
            ], "InlineFormula"],
            " copies the value to Wolfram Language when possible."
        }], "Notes"],
        Cell[TextData[{
            Cell[BoxData[
                RowBox[{"DeleteObject", "[", "object", "]"}]
            ], "InlineFormula"],
            " releases the value in GAP. Closing the session also invalidates it."
        }], "Notes"]
    }, Open]],
    Cell[CellGroupData[{
        Cell["See Also", "SeeAlsoSection"],
        Cell[TextData[{
            Cell[BoxData[
                ButtonBox["GAPCall", BaseStyle -> "Link",
                    ButtonData -> "paclet:WolframInstitute/GAPLink/ref/GAPCall"]
            ], "InlineSeeAlsoFunction"],
            StyleBox[" \[FilledVerySmallSquare] ", "InlineSeparator"],
            Cell[BoxData[
                ButtonBox["GAPEvaluate", BaseStyle -> "Link",
                    ButtonData -> "paclet:WolframInstitute/GAPLink/ref/GAPEvaluate"]
            ], "InlineSeeAlsoFunction"],
            StyleBox[" \[FilledVerySmallSquare] ", "InlineSeparator"],
            Cell[BoxData[
                ButtonBox["GAPSession", BaseStyle -> "Link",
                    ButtonData -> "paclet:WolframInstitute/GAPLink/ref/GAPSession"]
            ], "InlineSeeAlsoFunction"]
        }], "SeeAlso"]
    }, Open]],
    Cell[CellGroupData[{
        Cell["Examples Initialization", "ExamplesInitializationSection"],
        Cell[BoxData[
            RowBox[{"Needs", "[", "\"WolframInstitute`GAPLink`\"", "]"}]
        ], "ExampleInitialization"]
    }, Open]],
    Cell[CellGroupData[{
        Cell["Basic Examples", "PrimaryExamplesSection"],
        Cell["Keep a value in GAP:", "ExampleText"],
        Cell[BoxData[
            RowBox[{"session", "=", RowBox[{"StartGAPSession", "[", "]"}]}]
        ], "Input"],
        Cell[BoxData[
            RowBox[{"value", "=", RowBox[{"GAPCall", "[",
                RowBox[{"session", ",", "\"IdFunc\"", ",", "42", ",",
                    RowBox[{"\"ReturnType\"", "->", "\"Object\""}]}],
                "]"}]}]
        ], "Input"],
        Cell[BoxData[
            RowBox[{"Normal", "[", "value", "]"}]
        ], "Input"],
        Cell[BoxData[
            RowBox[{"DeleteObject", "/@",
                RowBox[{"{", RowBox[{"value", ",", "session"}], "}"}]}]
        ], "Input"]
    }, Open]],
    Cell[CellGroupData[{
        Cell["Metadata", "MetadataSection"],
        Cell["New in: 0.1", "History"],
        Cell[CellGroupData[{
            Cell["Categorization", "CategorizationSection"],
            Cell["Symbol", "Categorization", CellLabel -> "Entity Type"],
            Cell["WolframInstitute/GAPLink", "Categorization",
                CellLabel -> "Paclet Name"],
            Cell["WolframInstitute`GAPLink`", "Categorization",
                CellLabel -> "Context"],
            Cell["WolframInstitute/GAPLink/ref/GAPObject", "Categorization",
                CellLabel -> "URI"]
        }, Closed]]
    }, Open]]
},
    CellContext -> "Global`",
    TaggingRules -> <|"Paclet" -> "WolframInstitute/GAPLink"|>,
    StyleDefinitions -> FrontEnd`FileName[
        {"Wolfram"}, "FunctionPageStylesExt.nb",
        CharacterEncoding -> "UTF-8"
    ]
]
